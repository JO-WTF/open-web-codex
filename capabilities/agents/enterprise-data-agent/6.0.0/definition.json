{
  "definitionId": "enterprise-data-agent",
  "version": "6.0.0",
  "displayName": "仓网数据 Agent",
  "description": "在授权 Workspace 中检查并转换当前领域问题需要的数据，把结果提交到平台 Work State。",
  "runtimeRole": "agent_4214e235da7aa1d791f4b2951170397b",
  "runtimeProfile": {"contentSha256": "adb0254567b72ce52112894adbf1fbd21c2b0f11ca898e4f74b03e59aaea36be"},
  "responsibilities": [
    "读取平台 Work State 的数据需求，检查 CSV、JSON 和 XLSX 来源。",
    "生成并确认显式字段映射，在服务端标准化需求、仓库、当前覆盖和报价。",
    "只发布有界 Resource 引用、组件状态和有限问题摘要，不把完整数据行复制到消息。",
    "不计算覆盖、成本、时效和选址，也不自动加载 Mock 数据。"
  ],
  "inputArtifactTypes": ["data_requirement_profile.v2"],
  "outputArtifactTypes": [
    "source_profile.v1",
    "mapping_proposal.v1",
    "normalized_network_input.v1",
    "data_quality_report.v1",
    "administrative_catalog.v1",
    "input_gap.v1"
  ],
  "capabilityTemplate": {"definitionId": "enterprise-data-agent", "version": "6.0.0"},
  "requiredMcpServers": [
    {
      "name": "supply_chain_data",
      "tools": [
        "discover_workspace_sources",
        "inspect_workspace_sources",
        "publish_source_profile",
        "publish_mapping_proposal",
        "normalize_network_input",
        "validate_normalized_network_input",
        "load_administrative_catalog",
        "resolve_place_names",
        "build_administrative_candidates",
        "validate_points_within_boundaries"
      ],
      "resourceRead": false,
      "capabilityRootIds": ["local-supply-chain-network-planner"]
    },
    {
      "name": "platform_work_state",
      "tools": [
        "begin_work_operation",
        "apply_work_state_mutation",
        "fail_work_operation"
      ],
      "resourceRead": false,
      "capabilityRootIds": ["local-platform-work-state-mcp"]
    }
  ],
  "risks": [
    "字段歧义必须请求用户确认，不能根据名称猜测。",
    "源文件和敏感回答不得进入消息、日志或浏览器载荷。",
    "空 Workspace 和工具失败不得触发 Mock 回退。"
  ]
}
