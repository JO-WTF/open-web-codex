{
  "schemaVersion": "supervisor-package.v1",
  "policyId": "enterprise-supervisor-copilot",
  "version": "6.0.0",
  "displayName": "通用仓网规划 Supervisor",
  "description": "使用平台 Work State 动态协调数据准备和网络规划，不写死 Agent 顺序或分析阶段。",
  "responsibilities": [
    "识别国家、业务问题和当前最小缺口。",
    "创建并持有平台 Work State，把同一个有界状态引用交给各子 Agent。",
    "根据 Work State 状态动态协调 Data Agent 与 Network Agent。",
    "只汇总有限业务结果、假设、缺口和方案标签。"
  ],
  "instructionPolicy": {"policyId": "platform-supervisor-behavior", "version": "1.1.0"},
  "customInstructionsFile": "custom-instructions.md",
  "artifactContractsFile": "artifact-contracts.json",
  "coordinationCapabilities": [
    "platform_coordination.get_collaboration_status",
    "platform_coordination.list_agent_executions",
    "platform_coordination.get_work_state_summary",
    "platform_coordination.list_blocking_inputs",
    "platform_coordination.list_deliverables"
  ],
  "agents": [
    {"definitionId": "enterprise-data-agent", "version": "6.0.0", "runtimeRole": "agent_4214e235da7aa1d791f4b2951170397b", "spawnLimit": 1},
    {"definitionId": "enterprise-network-planning-agent", "version": "6.0.0", "runtimeRole": "agent_9ea657a9d4271d31e3d4c0ba6ecdfc23", "spawnLimit": 1}
  ],
  "runtimeRequirements": [{"capabilityId": "agents.multi_agent", "version": "1.0.0", "requiredLimits": {"exactRoleAllowlist": true, "exactRoleInstanceLimits": true}}],
  "execution": {"maxActiveChildAgents": 2}
}
