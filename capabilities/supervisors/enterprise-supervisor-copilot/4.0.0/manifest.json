{
  "schemaVersion": "supervisor-package.v1",
  "policyId": "enterprise-supervisor-copilot",
  "version": "4.0.0",
  "displayName": "Enterprise Supervisor Copilot",
  "description": "Dynamically coordinates Workspace data intake, Network Planning analysis and independently owned report and map delivery.",
  "responsibilities": [
    "Frame the user's decision and identify the smallest unresolved evidence gaps.",
    "Choose only the Agent roles needed for the current question without prescribing a fixed sequence.",
    "Enforce typed Artifact handoffs and resolve or disclose material conflicts.",
    "Close every explicit requested output with an evidence-backed value or a genuine typed gap.",
    "Deliver the deterministic report and map through their independently verified typed Artifact references without model-authored content copies."
  ],
  "instructionPolicy": {
    "policyId": "platform-supervisor-behavior",
    "version": "1.1.0"
  },
  "customInstructionsFile": "custom-instructions.md",
  "artifactContractsFile": "artifact-contracts.json",
  "dataRequirementContracts": [
    {
      "contractId": "indonesia-warehouse-network",
      "version": "2.0.0",
      "contentSha256": "9692a28e09483590dc0e7c79fc07561f3c7974a4020aff93624e78971a6c8044",
      "capabilityPackage": "supply-chain-network-planner"
    }
  ],
  "agents": [
    {
      "definitionId": "enterprise-data-agent",
      "version": "4.0.0",
