      "spawnLimit": 1
    },
    {
      "definitionId": "enterprise-network-planning-agent",
      "version": "4.0.0",
      "runtimeRole": "agent_0ce6d3576eadd88251381ad1d46cebe5",
      "spawnLimit": 1
    },
    {
      "definitionId": "enterprise-visualization-agent",
      "version": "2.0.0",
