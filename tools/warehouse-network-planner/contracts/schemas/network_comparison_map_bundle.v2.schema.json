      "properties": {
        "added_facility": {
          "title": "Added Facility",
          "type": "boolean"
        },
        "after_active": {
          "title": "After Active",
          "type": "boolean"
        },
        "before_active": {
          "title": "Before Active",
          "type": "boolean"
        },
        "city_id": {
          "title": "City Id",
          "type": "string"
        },
        "city_name": {
          "title": "City Name",
          "type": "string"
        },
        "is_existing": {
          "title": "Is Existing",
          "type": "boolean"
        },
        "kind": {
          "const": "warehouse",
          "default": "warehouse",
          "title": "Kind",
          "type": "string"
        },
        "province_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Province Id"
        },
        "province_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Province Name"
        },
        "removed_facility": {
          "title": "Removed Facility",
          "type": "boolean"
        },
        "warehouse_id": {
          "title": "Warehouse Id",
          "type": "string"
        },
        "warehouse_name": {
          "title": "Warehouse Name",
          "type": "string"
        },
        "warehouse_type": {
          "enum": [
            "center",
            "cross_docking"
          ],
          "title": "Warehouse Type",
          "type": "string"
        }
      },
      "required": [
        "warehouse_id",
        "warehouse_name",
        "warehouse_type",
        "city_id",
        "city_name",
        "province_id",
        "province_name",
        "is_existing",
        "before_active",
        "after_active",
        "added_facility",
        "removed_facility"
      ],
      "title": "WarehouseMapProperties",
      "type": "object"
    }
