  "$id": "urn:open-web-codex:supply-chain:network_comparison_map_bundle.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "geojson": {
      "$ref": "#/$defs/NetworkMapFeatureCollection"
    },
    "kind": {
      "const": "network_comparison_map",
      "default": "network_comparison_map",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "network_comparison_map_bundle.v2",
      "default": "network_comparison_map_bundle.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/NetworkMapSummary"
    }
  },
  "required": [
    "summary",
    "geojson"
  ],
  "title": "Network comparison map bundle",
  "type": "object"
}
