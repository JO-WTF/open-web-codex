          "default": null,
          "title": "After Unit Cost"
        },
        "after_warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Warehouse Id"
        },
        "assigned_warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Warehouse Id"
        },
        "before_distance_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Distance Km"
        },
        "before_duration_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Duration Hours"
        },
        "before_unit_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Unit Cost"
        },
        "before_warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Warehouse Id"
        },
        "city_id": {
          "title": "City Id",
          "type": "string"
        },
        "city_name": {
          "title": "City Name",
          "type": "string"
        },
        "demand_quantity": {
          "minimum": 0,
          "title": "Demand Quantity",
          "type": "number"
        },
        "distance_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "duration_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Hours"
        },
        "kind": {
          "const": "demand",
          "default": "demand",
          "title": "Kind",
          "type": "string"
        },
        "province_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Province Id"
        },
        "province_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Province Name"
        },
        "unit_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost"
        }
      },
      "required": [
        "city_id",
        "city_name",
        "province_id",
        "province_name",
        "demand_quantity"
      ],
      "title": "DemandMapProperties",
      "type": "object"
    },
    "LineStringGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineStringGeometry",
      "type": "object"
    },
    "LinehaulMapProperties": {
      "additionalProperties": false,
      "properties": {
        "assigned_demand": {
          "minimum": 0,
          "title": "Assigned Demand",
          "type": "number"
        },
        "crossdock_warehouse_id": {
          "title": "Crossdock Warehouse Id",
          "type": "string"
        },
        "kind": {
          "const": "linehaul_connection",
          "default": "linehaul_connection",
          "title": "Kind",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "before",
            "after",
            "scenario"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "upstream_center_id": {
          "title": "Upstream Center Id",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "upstream_center_id",
        "crossdock_warehouse_id",
        "assigned_demand"
      ],
      "title": "LinehaulMapProperties",
      "type": "object"
    },
    "NetworkMapFeature": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/PointGeometry"
            },
            {
              "$ref": "#/$defs/LineStringGeometry"
            }
          ],
          "title": "Geometry"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "properties": {
          "anyOf": [
            {
              "$ref": "#/$defs/WarehouseMapProperties"
            },
            {
              "$ref": "#/$defs/DemandMapProperties"
            },
            {
              "$ref": "#/$defs/AssignmentMapProperties"
            },
            {
              "$ref": "#/$defs/LinehaulMapProperties"
            }
          ],
          "title": "Properties"
        },
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "NetworkMapFeature",
      "type": "object"
    },
    "NetworkMapFeatureCollection": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "items": {
            "$ref": "#/$defs/NetworkMapFeature"
          },
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "FeatureCollection",
          "default": "FeatureCollection",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "features"
      ],
      "title": "NetworkMapFeatureCollection",
      "type": "object"
    },
    "NetworkMapSummary": {
      "additionalProperties": false,
      "properties": {
        "added_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Added Warehouse Ids",
          "type": "array"
        },
        "after_active_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "After Active Warehouse Ids",
          "type": "array"
        },
        "after_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Cost"
        },
        "after_label": {
          "title": "After Label",
          "type": "string"
        },
        "before_active_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Before Active Warehouse Ids",
          "type": "array"
        },
        "before_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Cost"
        },
        "before_label": {
          "title": "Before Label",
          "type": "string"
        },
        "cost_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Delta"
        },
        "country_code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country Code",
          "type": "string"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/CoverageComparison"
          },
          "title": "Coverage",
          "type": "array"
        },
        "feature_count": {
          "minimum": 0,
          "title": "Feature Count",
          "type": "integer"
        },
        "removed_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Warehouse Ids",
          "type": "array"
        }
      },
      "required": [
        "country_code",
        "before_label",
        "after_label",
        "feature_count",
        "before_active_warehouse_ids",
        "after_active_warehouse_ids",
        "added_warehouse_ids",
        "removed_warehouse_ids",
        "before_cost",
        "after_cost",
        "cost_delta",
        "coverage"
      ],
      "title": "NetworkMapSummary",
      "type": "object"
    },
    "PointGeometry": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "WarehouseMapProperties": {
