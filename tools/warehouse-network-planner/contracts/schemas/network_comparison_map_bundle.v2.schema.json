{
  "$defs": {
    "AssignmentMapProperties": {
      "additionalProperties": false,
      "properties": {
        "demand_city_id": {
          "title": "Demand City Id",
          "type": "string"
        },
        "demand_quantity": {
          "minimum": 0,
          "title": "Demand Quantity",
          "type": "number"
        },
        "distance_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distance Km"
        },
        "duration_hours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Hours"
        },
        "kind": {
          "const": "last_mile_assignment",
          "default": "last_mile_assignment",
          "title": "Kind",
          "type": "string"
        },
        "result_label": {
          "title": "Result Label",
          "type": "string"
        },
        "scenario": {
          "enum": [
            "before",
            "after",
            "scenario"
          ],
          "title": "Scenario",
          "type": "string"
        },
        "unit_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Cost"
        },
        "warehouse_id": {
          "title": "Warehouse Id",
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "result_label",
        "warehouse_id",
        "demand_city_id",
        "demand_quantity",
        "distance_km",
        "duration_hours",
        "unit_cost"
      ],
      "title": "AssignmentMapProperties",
      "type": "object"
    },
    "CoverageComparison": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/CoverageMetricSummary"
        },
        "before": {
          "$ref": "#/$defs/CoverageMetricSummary"
        },
        "delta": {
          "$ref": "#/$defs/CoverageMetricDelta"
        },
        "target_hours": {
          "exclusiveMinimum": 0,
          "title": "Target Hours",
          "type": "number"
        }
      },
      "required": [
        "target_hours",
        "before",
        "after",
        "delta"
      ],
      "title": "CoverageComparison",
      "type": "object"
    },
    "CoverageMetricDelta": {
      "additionalProperties": false,
      "properties": {
        "city_coverage_rate": {
          "maximum": 1,
          "minimum": -1,
          "title": "City Coverage Rate",
          "type": "number"
        },
        "covered_city_count": {
          "title": "Covered City Count",
          "type": "integer"
        },
        "covered_demand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Covered Demand"
        },
        "demand_weighted_coverage_rate": {
          "maximum": 1,
          "minimum": -1,
          "title": "Demand Weighted Coverage Rate",
          "type": "number"
        },
        "total_city_count": {
          "title": "Total City Count",
          "type": "integer"
        },
        "total_demand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        }
      },
      "required": [
        "covered_city_count",
        "total_city_count",
        "city_coverage_rate",
        "covered_demand",
        "total_demand",
        "demand_weighted_coverage_rate"
      ],
      "title": "CoverageMetricDelta",
      "type": "object"
    },
    "CoverageMetricSummary": {
      "additionalProperties": false,
      "description": "Both city-count and demand-weighted service coverage for one target.",
      "properties": {
        "city_coverage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "City Coverage Rate",
          "type": "number"
        },
        "covered_city_count": {
          "minimum": 0,
          "title": "Covered City Count",
          "type": "integer"
        },
        "covered_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Covered Demand"
        },
        "demand_weighted_coverage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Demand Weighted Coverage Rate",
          "type": "number"
        },
        "target_hours": {
          "exclusiveMinimum": 0,
          "title": "Target Hours",
          "type": "number"
        },
        "total_city_count": {
          "minimum": 0,
          "title": "Total City Count",
          "type": "integer"
        },
        "total_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        }
      },
      "required": [
        "target_hours",
        "covered_city_count",
        "total_city_count",
        "city_coverage_rate",
        "covered_demand",
        "total_demand",
        "demand_weighted_coverage_rate"
      ],
      "title": "CoverageMetricSummary",
      "type": "object"
    },
    "DemandMapProperties": {
      "additionalProperties": false,
      "properties": {
        "after_distance_km": {
