          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Covered Demand"
        },
        "target_hours": {
          "exclusiveMinimum": 0,
          "title": "Target Hours",
          "type": "number"
        },
        "total_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        }
      },
      "required": [
        "target_hours",
        "covered_demand",
        "total_demand",
        "coverage_rate"
      ],
      "title": "ServiceMetric",
      "type": "object"
    },
    "WarehouseRecord": {
      "additionalProperties": false,
      "properties": {
        "city_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "City Id",
          "type": "string"
        },
        "city_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "City Name",
          "type": "string"
        },
        "is_existing": {
          "title": "Is Existing",
          "type": "boolean"
        },
        "is_fixed": {
          "anyOf": [
            {
              "type": "boolean"
