{
  "$defs": {
    "AssignmentComparison": {
      "additionalProperties": false,
      "properties": {
        "affected_city_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected City Ids",
          "type": "array"
        },
        "after_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Cost"
        },
        "before_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Cost"
        },
        "city_changes": {
          "items": {
            "$ref": "#/$defs/CityAssignmentChange"
          },
          "title": "City Changes",
          "type": "array"
        },
        "cost_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Delta"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/CoverageComparison"
          },
          "title": "Coverage",
          "type": "array"
        },
        "reassigned_city_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reassigned City Ids",
          "type": "array"
        },
        "removed_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Warehouse Ids",
          "type": "array"
        },
        "requested_service_targets": {
          "items": {
            "type": "number"
          },
          "title": "Requested Service Targets",
          "type": "array"
        },
        "schema_version": {
          "const": "network_assignment_comparison.v2",
          "default": "network_assignment_comparison.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Warehouse Ids",
          "type": "array"
        }
      },
      "required": [
        "requested_service_targets",
        "coverage",
        "selected_warehouse_ids",
        "removed_warehouse_ids",
        "affected_city_ids",
        "reassigned_city_ids",
        "city_changes"
      ],
      "title": "AssignmentComparison",
      "type": "object"
    },
    "AssignmentResult": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "enum": [
            "min_time",
            "min_cost"
          ],
          "title": "Objective",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AssignmentRow"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "network_assignment.v1",
          "default": "network_assignment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "total_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        },
        "unassigned_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Unassigned Demand"
        }
      },
      "required": [
        "objective",
        "rows",
        "total_demand",
        "unassigned_demand"
      ],
      "title": "AssignmentResult",
      "type": "object"
    },
    "AssignmentRow": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "demand_city_id": {
          "title": "Demand City Id",
          "type": "string"
        },
        "demand_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Demand Quantity"
        },
        "distance_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "duration_hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Hours"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "upstream_center_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Center Id"
        },
        "warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Warehouse Id"
        }
      },
      "required": [
        "demand_city_id",
        "warehouse_id",
        "demand_quantity"
      ],
      "title": "AssignmentRow",
      "type": "object"
    },
    "CityAssignmentChange": {
      "additionalProperties": false,
      "properties": {
        "affected": {
          "title": "Affected",
          "type": "boolean"
        },
        "after_warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Warehouse Id"
        },
        "before_warehouse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Warehouse Id"
        },
        "cost_per_unit_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Per Unit Delta"
        },
        "demand_city_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Demand City Id",
          "type": "string"
        },
        "duration_hours_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Hours Delta"
        },
        "reassigned": {
          "title": "Reassigned",
          "type": "boolean"
        }
      },
      "required": [
        "demand_city_id",
        "affected",
        "reassigned"
      ],
      "title": "CityAssignmentChange",
      "type": "object"
    },
    "CostSummary": {
      "additionalProperties": false,
      "properties": {
        "by_warehouse": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "By Warehouse",
          "type": "object"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "last_mile": {
          "minimum": 0,
          "title": "Last Mile",
          "type": "number"
        },
        "last_mile_by_warehouse": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Last Mile By Warehouse",
          "type": "object"
        },
        "linehaul": {
          "minimum": 0,
          "title": "Linehaul",
          "type": "number"
        },
        "linehaul_by_warehouse": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Linehaul By Warehouse",
          "type": "object"
        },
        "missing_routes": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Missing Routes",
          "type": "array"
        },
        "schema_version": {
          "const": "network_cost_summary.v1",
          "default": "network_cost_summary.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "currency",
        "total",
        "linehaul",
        "last_mile"
      ],
      "title": "CostSummary",
      "type": "object"
    },
    "CoverageComparison": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/CoverageMetricSummary"
        },
        "before": {
          "$ref": "#/$defs/CoverageMetricSummary"
        },
        "delta": {
          "$ref": "#/$defs/CoverageMetricDelta"
        },
        "target_hours": {
          "exclusiveMinimum": 0,
          "title": "Target Hours",
          "type": "number"
        }
      },
      "required": [
        "target_hours",
        "before",
        "after",
        "delta"
      ],
      "title": "CoverageComparison",
      "type": "object"
    },
    "CoverageMetricDelta": {
      "additionalProperties": false,
      "properties": {
        "city_coverage_rate": {
          "maximum": 1,
          "minimum": -1,
          "title": "City Coverage Rate",
          "type": "number"
        },
        "covered_city_count": {
          "title": "Covered City Count",
          "type": "integer"
        },
        "covered_demand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Covered Demand"
        },
        "demand_weighted_coverage_rate": {
          "maximum": 1,
          "minimum": -1,
          "title": "Demand Weighted Coverage Rate",
          "type": "number"
        },
        "total_city_count": {
          "title": "Total City Count",
          "type": "integer"
        },
        "total_demand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        }
      },
      "required": [
        "covered_city_count",
        "total_city_count",
        "city_coverage_rate",
        "covered_demand",
        "total_demand",
        "demand_weighted_coverage_rate"
      ],
      "title": "CoverageMetricDelta",
      "type": "object"
    },
    "CoverageMetricSummary": {
      "additionalProperties": false,
      "description": "Both city-count and demand-weighted service coverage for one target.",
      "properties": {
        "city_coverage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "City Coverage Rate",
          "type": "number"
        },
        "covered_city_count": {
          "minimum": 0,
          "title": "Covered City Count",
          "type": "integer"
        },
        "covered_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Covered Demand"
        },
        "demand_weighted_coverage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Demand Weighted Coverage Rate",
          "type": "number"
        },
        "target_hours": {
          "exclusiveMinimum": 0,
          "title": "Target Hours",
          "type": "number"
        },
        "total_city_count": {
          "minimum": 0,
          "title": "Total City Count",
          "type": "integer"
        },
        "total_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        }
      },
      "required": [
        "target_hours",
        "covered_city_count",
        "total_city_count",
        "city_coverage_rate",
        "covered_demand",
        "total_demand",
        "demand_weighted_coverage_rate"
      ],
      "title": "CoverageMetricSummary",
      "type": "object"
    },
    "DemandCityRecord": {
      "additionalProperties": false,
      "properties": {
        "city_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "City Id",
          "type": "string"
        },
        "city_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "City Name",
          "type": "string"
        },
        "demand_quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Demand Quantity"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "province_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province Id"
        },
        "province_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province Name"
        }
      },
      "required": [
        "city_id",
        "city_name",
        "demand_quantity"
      ],
      "title": "DemandCityRecord",
      "type": "object"
    },
    "NetworkComparableReport": {
      "additionalProperties": false,
      "description": "Stable report projection shared by any comparable result kind.",
      "properties": {
        "active_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Active Warehouse Ids",
          "type": "array"
        },
        "added_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Added Warehouse Ids",
          "type": "array"
        },
        "assignment": {
          "$ref": "#/$defs/AssignmentResult"
        },
        "best_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Best Bound"
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notice"
        },
        "objective_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Objective Value"
        },
        "optimality": {
          "anyOf": [
            {
              "enum": [
                "proven",
                "feasible_only",
                "not_available"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Optimality"
        },
        "removed_warehouse_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Warehouse Ids",
          "type": "array"
        },
        "service": {
          "items": {
            "$ref": "#/$defs/ServiceMetric"
          },
          "title": "Service",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "optimal",
                "feasible",
                "timeout",
                "infeasible",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "label",
        "active_warehouse_ids",
        "added_warehouse_ids",
        "removed_warehouse_ids",
        "assignment",
        "objective_value",
        "best_bound",
        "cost",
        "service",
        "status",
        "optimality",
        "notice"
      ],
      "title": "NetworkComparableReport",
      "type": "object"
    },
    "NetworkReportEntities": {
      "additionalProperties": false,
      "properties": {
        "demand_cities": {
          "items": {
            "$ref": "#/$defs/DemandCityRecord"
          },
          "title": "Demand Cities",
          "type": "array"
        },
        "warehouses": {
          "items": {
            "$ref": "#/$defs/WarehouseRecord"
          },
          "title": "Warehouses",
          "type": "array"
        }
      },
      "required": [
        "demand_cities",
        "warehouses"
      ],
      "title": "NetworkReportEntities",
      "type": "object"
    },
    "NetworkReportScope": {
      "additionalProperties": false,
      "properties": {
        "candidate_warehouse_count": {
          "minimum": 0,
          "title": "Candidate Warehouse Count",
          "type": "integer"
        },
        "demand_city_count": {
          "minimum": 0,
          "title": "Demand City Count",
          "type": "integer"
        },
        "existing_warehouse_count": {
          "minimum": 0,
          "title": "Existing Warehouse Count",
          "type": "integer"
        },
        "total_demand": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Total Demand"
        },
        "warehouse_count": {
          "minimum": 0,
          "title": "Warehouse Count",
          "type": "integer"
        }
      },
      "required": [
        "demand_city_count",
        "warehouse_count",
        "existing_warehouse_count",
        "candidate_warehouse_count",
        "total_demand"
      ],
      "title": "NetworkReportScope",
      "type": "object"
    },
    "ServiceMetric": {
      "additionalProperties": false,
