        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "province_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province Id"
        },
        "province_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Province Name"
        },
        "upstream_center_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Center Id"
        },
        "warehouse_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Warehouse Id",
          "type": "string"
        },
        "warehouse_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Warehouse Name",
          "type": "string"
        },
        "warehouse_type": {
          "enum": [
            "center",
            "cross_docking"
          ],
          "title": "Warehouse Type",
          "type": "string"
        }
      },
      "required": [
        "warehouse_id",
        "warehouse_name",
        "warehouse_type",
